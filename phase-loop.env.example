# Copy to ./.test/brownie-loop.env for the same LAN LLM environment used by
# .test/sample.md smoke runs. Copy to ./phase-loop.env or
# ./.brownie-phase-loop/phase-loop.env only for phase-loop-specific overrides.
# Do not commit real credentials.

# OpenAI-compatible provider for Brownie.
# OPENAI_API_KEY=
# BROWNIE_LLM_PROVIDER=openai-compatible
# BROWNIE_LLM_BASE_URL=http://127.0.0.1:8080/v1
# BROWNIE_LLM_MODEL=qwen35-MTP
# BROWNIE_LLM_MAX_TOKENS=4096
# BROWNIE_LLM_REQUEST_TIMEOUT_MS=300000
# BROWNIE_LLM_ALLOW_TASK_RUN_NETWORK=true
# BROWNIE_LLM_STRICT=true
# BROWNIE_CLI_RUN_MODE_ID=provider-runner

# Brownie runtime limits.
BROWNIE_RUNTIME_OBJECTIVE_TIMEOUT_MS=300000

# Optional overrides for the phase loop wrapper. The wrapper loads
# .test/brownie-loop.env first, then phase-loop.env, then state-local overrides.
# BROWNIE_BIN=/Users/satoshitanaka/Documents/brownie/target/debug/brownie
# PHASE_LOOP_PROMPT=/Users/satoshitanaka/Documents/brownie/phase-loop.md
# PHASE_LOOP_WORKSPACE_ROOT=/Users/satoshitanaka/Documents/brownie
# PHASE_LOOP_CONTROL_ROOT=/Users/satoshitanaka/.codex/automations/brownie-cli-phase-loop
# PHASE_LOOP_STATE_DIR=/Users/satoshitanaka/Documents/brownie/.brownie-phase-loop
# PHASE_LOOP_INTERVAL_SECONDS=5
# PHASE_LOOP_FAILURE_BACKOFF_SECONDS=60
# PHASE_LOOP_MAX_FAILURE_BACKOFF_SECONDS=900
# PHASE_LOOP_BROWNIE_TIMEOUT_SECONDS=14400
