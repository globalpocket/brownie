# Copy to ./.test/brownie-loop.env for the same LAN LLM environment used by
# .test/sample.md smoke runs. Copy to ./phase-loop.env or
# ./.brownie-phase-loop/phase-loop.env only for phase-loop-specific overrides.
# Do not commit real credentials.

# OpenAI-compatible provider for Brownie.
# OPENAI_API_KEY=
# BROWNIE_LLM_PROVIDER=openai-compatible
# BROWNIE_LLM_BASE_URL=http://127.0.0.1:8080/v1
# BROWNIE_LLM_MODEL=qwen35-MTP
# BROWNIE_LLM_MAX_TOKENS=4096
# BROWNIE_LLM_REQUEST_TIMEOUT_MS=300000
# BROWNIE_LLM_ALLOW_PROVIDER_ACCESS=true
# BROWNIE_LLM_ALLOW_TASK_RUN_NETWORK=true
# BROWNIE_LLM_STRICT=true
# Use implementer for the Product Ready phase loop. provider-runner is useful
# for LLM-provider smoke checks, but it cannot write workspace changes, run
# verifiers, commit, or advance implementation TODOs.
# BROWNIE_CLI_RUN_MODE_ID=implementer

# Brownie runtime limits.
BROWNIE_RUNTIME_OBJECTIVE_TIMEOUT_MS=600000

# Optional overrides for the phase loop wrapper. The wrapper loads
# .test/brownie-loop.env first, then phase-loop.env, then state-local overrides.
# BROWNIE_BIN=/Users/satoshitanaka/Documents/brownie/target/debug/brownie
# PHASE_LOOP_PROMPT=/Users/satoshitanaka/Documents/brownie/phase-loop.md
# PHASE_LOOP_TODO=/Users/satoshitanaka/Documents/brownie/todo.md
# PHASE_LOOP_WORKSPACE_ROOT=/Users/satoshitanaka/Documents/brownie
# PHASE_LOOP_CONTROL_ROOT=/Users/satoshitanaka/.codex/automations/brownie-cli-phase-loop
# PHASE_LOOP_STATE_DIR=/Users/satoshitanaka/Documents/brownie/.brownie-phase-loop
# PHASE_LOOP_INTERVAL_SECONDS=5
# PHASE_LOOP_FAILURE_BACKOFF_SECONDS=60
# PHASE_LOOP_MAX_FAILURE_BACKOFF_SECONDS=900
# PHASE_LOOP_BROWNIE_TIMEOUT_SECONDS=14400
# PHASE_LOOP_CREATE_PR_AFTER_PROGRESS=0
# PHASE_LOOP_PR_REMOTE=origin
# PHASE_LOOP_PR_BASE=main
# PHASE_LOOP_PR_TITLE_PREFIX=Brownie phase-loop
# PHASE_LOOP_PR_DRAFT=0
# PHASE_LOOP_OPERATIONAL_PR_TEST=verified-by-brownie
# PHASE_LOOP_OPERATIONAL_PR_TEST_PATH_SCOPED=verified-by-brownie

# Optional BDK/Prompt/LLM routing. The phase-loop effective prompt classifies
# each claimed TODO into a small BDK state and route. If these route-specific
# model variables are unset, the wrapper keeps the existing BROWNIE_LLM_MODEL.
# PHASE_LOOP_LLM_ROUTING=1
# PHASE_LOOP_LLM_MODEL_FAST=qwen35-4b-q4km
# PHASE_LOOP_LLM_MODEL_CODE=qwen35-9b-coder-q4km
# PHASE_LOOP_LLM_MODEL_DEEP=qwen35-Think
# The wrapper applies model-specific defaults for known LAN aliases unless
# these values are explicitly set. Use low-temperature settings for structured
# Brownie tool-intent / workspace.write output.
# PHASE_LOOP_LLM_TEMPERATURE_FAST=0
# PHASE_LOOP_LLM_TOP_P_FAST=0.8
# PHASE_LOOP_LLM_TOP_K_FAST=20
# PHASE_LOOP_LLM_MAX_TOKENS_FAST=512
# PHASE_LOOP_LLM_TEMPERATURE_CODE=0
# PHASE_LOOP_LLM_TOP_P_CODE=0.8
# PHASE_LOOP_LLM_TOP_K_CODE=20
# PHASE_LOOP_LLM_MAX_TOKENS_CODE=512
# Direct Runtime/OpenAI-compatible calls also accept:
# BROWNIE_LLM_TEMPERATURE=0
# BROWNIE_LLM_TOP_P=0.8
# BROWNIE_LLM_TOP_K=20
