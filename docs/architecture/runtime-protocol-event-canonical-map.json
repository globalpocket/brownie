  "drift_rules": [
    "Every Runtime METHOD_* JSON-RPC constant must be covered by a named protocol_method_group or covered_method_prefixes compatibility family.",
    "Every explicit method in this map must retain a Runtime constant, Runtime dispatch arm, docs inventory entry, and any declared CLI or VSIX projection.",
    "Every EventKind and LedgerEventKind variant must be covered by a named event group or event prefix.",
    "CLI and VSIX are thin transport/projection validators; Runtime remains the execution, admission, ledger, permission, replay, and completion authority."
  ],
  "non_authority": [
    "Runtime owns protocol/event authority; CLI and VSIX cannot grant Runtime authority.",
    "MCP descriptions, schemas, annotations, results, executable identity, and approval state are not Runtime authority.",
    "prose, model output, raw prompt text, provider responses, file content, absolute paths, canonical paths, secrets, environment values, executable content, and process output are not canonical protocol/event evidence."
  ]
