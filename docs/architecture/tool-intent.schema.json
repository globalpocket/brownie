{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/globalpocket/brownie/docs/architecture/tool-intent.schema.json",
  "title": "Brownie Tool Intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool_requests"],
  "properties": {
    "tool_requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool_id", "reason", "input"],
        "properties": {
          "tool_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "input": {
            "oneOf": [
              {
                "$ref": "#/$defs/workspace_read_input"
              },
              {
                "$ref": "#/$defs/workspace_write_input"
              },
              {
                "$ref": "#/$defs/generic_tool_input"
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^/"
          },
          {
            "pattern": "^[A-Za-z]:[\\\\/]"
          },
          {
            "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)"
          },
          {
            "pattern": "[\\r\\n\\u0000]"
          }
        ]
      }
    },
    "workspace_read_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative_path"
        }
      }
    },
    "workspace_write_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operation"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "operation": {
          "type": "string",
          "enum": ["replace_file", "create_file", "delete_file", "patch_file"]
        },
        "content": {
          "type": "string",
          "maxLength": 20000
        },
        "old_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "new_text": {
          "type": "string",
          "maxLength": 20000
        },
        "hunks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["old_text", "new_text"],
            "properties": {
              "old_text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "new_text": {
                "type": "string",
                "maxLength": 20000
              },
              "occurrence": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "delete_file"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["content"]
                },
                {
                  "required": ["old_text"]
                },
                {
                  "required": ["new_text"]
                },
                {
                  "required": ["hunks"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "patch_file"
              }
            }
          },
          "then": {
            "oneOf": [
              {
                "required": ["old_text", "new_text"]
              },
              {
                "required": ["content"]
              },
              {
                "required": ["hunks"]
              }
            ]
          }
        }
      ]
    },
    "generic_tool_input": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
