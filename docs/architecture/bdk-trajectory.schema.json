{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/globalpocket/brownie/docs/architecture/bdk-trajectory.schema.json",
  "title": "Brownie BDK public-harness-compatible trajectory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "claim_id", "events"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "at", "todo_id", "claim_id", "payload"],
        "properties": {
          "type": {
            "enum": [
              "todo.claimed",
              "workflow.routed",
              "skill.selected",
              "tool.read",
              "tool.write_proposed",
              "tool.write_applied",
              "verification.run",
              "progress.classified",
              "todo.completed",
              "todo.replanned",
              "todo.blocked"
            ]
          },
          "at": {
            "type": "string",
            "minLength": 1
          },
          "todo_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "payload": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
