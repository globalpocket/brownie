{
  "name": "brownie-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Brownie Code-OSS extension and Rust runtime workspace.",
  "scripts": {
    "build": "pnpm --filter brownie-vsix build",
    "check": "pnpm --filter brownie-vsix check",
    "guard:control-plane-authority": "node scripts/guard-control-plane-authority.mjs",
    "guard:control-plane-authority:test": "node --test scripts/guard-control-plane-authority.test.mjs",
    "guard:diagnostics": "node scripts/guard-diagnostics-api.mjs",
    "guard:phase-value": "node scripts/guard-phase-value.mjs",
    "guard:phase-value:test": "node --test scripts/guard-phase-value.test.mjs",
    "guard:product-completion": "node scripts/guard-product-completion.mjs",
    "guard:product-completion:test": "node --test scripts/guard-product-completion.test.mjs",
    "guard:runtime-release-readiness": "node scripts/guard-runtime-release-readiness.mjs",
    "guard:runtime-release-readiness:test": "node --test scripts/guard-runtime-release-readiness.test.mjs",
    "install:cli": "node scripts/install-brownie-cli.mjs",
    "install:cli:test": "node --test scripts/install-brownie-cli.test.mjs",
    "test:rrp3-process-loss": "node scripts/rrp3-process-loss-recovery-e2e.mjs",
    "test": "pnpm --filter brownie-vsix test"
  },
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {}
}
