{
  "project": "brownie",
  "schema_version": 2,
  "authoritative": false,
  "source_of_truth": "external_automation_root",
  "external_automation_root": "~/.codex/automations/brownie-phase-loop/",
  "authoritative_state_file": "phase-state.json",
  "active_prompt_directory": "prompts/",
  "latest_review_file": "latest-review.md",
  "review_memory_file": "review-memory.md",
  "stop_reason_file": "stop-reason.md",
  "controller_instructions_file": "automation.toml",
  "lock_directory": "run.lock",
  "purpose": "Compatibility pointer only. Scheduled Brownie phase-loop runs must read the external automation root for live phase state.",
  "guard": {
    "script": "scripts/guard-control-plane-authority.mjs",
    "rejects_repo_local_live_state": true,
    "rejects_legacy_phase_state": true
  }
}
